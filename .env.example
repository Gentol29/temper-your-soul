# Solo server: copiare in .env e compilare fuori dal controllo versione.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Endpoint HTTPS del provider esistente: valida Bearer e restituisce sub oppure id.
AUTH_USERINFO_URL=https://identity.example/userinfo
# Pagina di accesso esistente, con ritorno al gioco tramite callback/evento documentato.
AUTH_LOGIN_URL=https://identity.example/login
# Alternativa Supabase: SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY per /auth/v1/user.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Login email/password nel gioco: impostare supabase-password, URL e chiave Supabase.
# In questa modalità AUTH_LOGIN_URL non serve.
# AUTH_MODE=supabase-password
# Facoltativo: URL del gioco ammesso anche nei Redirect URLs di Supabase Auth.
# In assenza si usa il Site URL del progetto; dopo la conferma si può tornare al gioco e accedere.
# AUTH_EMAIL_REDIRECT_URL=https://game.example/
# Schema JSON canonico: json. Tabella esistente con metadati e inventory: legacy-v9.
PROFILES_LAYOUT=json
PROFILES_SCHEMA=public
PROFILES_TABLE=profiles
PROFILES_ID_COLUMN=id
PROFILES_CHARACTER_COLUMN=character
PROFILES_GOLD_COLUMN=gold
PROFILES_REVISION_COLUMN=revision
# Con PROFILES_LAYOUT=legacy-v9 usare account_id, inventory e updated_at come colonne.
# Origini browser consentite, separate da virgole; vuoto per sviluppo locale.
ALLOWED_ORIGINS=
PORT=4173
# Solo verifica SQL isolata, non impostare verso un database di produzione.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/TEST_DATABASE
